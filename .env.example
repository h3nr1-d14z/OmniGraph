# OmniGraph Hub Configuration
# Copy to .env and adjust for your deployment target

# ============================================
# Ports
# ============================================
QDRANT_PORT=6333
MEMGRAPH_BOLT_PORT=7687
MEMGRAPH_HTTP_PORT=3000
EMBED_SERVICE_PORT=8000
MCP_SERVER_PORT=8001

# ============================================
# Resource Limits (adjust to your machine spec)
# ============================================
QDRANT_MEM_LIMIT=8g
MEMGRAPH_MEM_LIMIT=6g

# ============================================
# Embedding Backend
# Options: auto | onnx | openvino | mlx | jina
# auto = detect platform (openvino on Intel Linux, mlx on Apple Silicon, onnx fallback)
# jina = jinaai/jina-embeddings-v2-base-code (Apache 2.0, code-specialized, 768d, 8192 ctx)
# ============================================
EMBED_BACKEND=auto
EMBED_WORKERS=1
EMBED_BATCH_SIZE=32

# Model name or path
EMBED_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
# After Phase 4 cutover, set EMBED_BACKEND=jina and EMBED_MODEL_NAME=jinaai/jina-embeddings-v2-base-code
# Then point QDRANT_COLLECTION=code_v2_jina (collection-per-model isolation)

# ============================================
# Networking (Cloudflare Tunnel)
# ============================================
CF_TUNNEL_URL=
HUB_AUTH_TOKEN=changeme-strong-token-here

# ============================================
# Qdrant Config
# ============================================
# Collection-per-model isolation (US-009). During Phase 4 cutover,
# code_v1_nomic is the legacy collection (rollback target); code_v2_jina
# is the post-cutover target. Hub picks active collection from this var.
QDRANT_COLLECTION=code_v1_nomic
QDRANT_VECTOR_DIM=768
QDRANT_ON_DISK=true
QDRANT_STATS_EXACT=false
QDRANT_STATS_SCOPED_EXACT=true

# ============================================
# Embed chunking (US-008)
# ============================================
EMBED_MAX_CHARS=32000
SLIDING_WINDOW_CHARS=2400
SLIDING_STRIDE_CHARS=600
MAX_CHUNKS_PER_FILE=64
MAX_CHUNKS_PER_REQUEST=32

# ============================================
# Hub Content Store
# ============================================
CONTENT_DB_PATH=./data/hub-content.db

# ============================================
# Memgraph Config
# ============================================
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
